{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tapid.dev/schemas/tapid-release-manifest-v1.json",
  "title": "Tapid Release Manifest v1",
  "description": "Signed metadata describing immutable Tapid client release artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product", "version", "tag", "commit", "artifacts", "signature"],
  "properties": {
    "schema": {"const": "tapid-release-manifest-v1"},
    "product": {"const": "tapid"},
    "version": {"type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$"},
    "tag": {"type": "string", "pattern": "^v0\\.[0-9]+\\.[0-9]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "sbom": {"$ref": "#/$defs/document"},
    "provenance": {"$ref": "#/$defs/document"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "url", "sha256", "size"],
      "properties": {
        "name": {"type": "string", "pattern": "^tapid-[0-9]+\\.[0-9]+\\.[0-9]+-[A-Za-z0-9._-]+\\.(tar\\.gz|zip)$"},
        "target": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "media_type"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signed_digest", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "signed_digest": {"type": "string", "pattern": "^sha256-[0-9a-f]{64}$"},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
