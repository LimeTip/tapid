{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tapid:dependency-preview:v1",
  "title": "Tapid dependency preview payload v1",
  "description": "Metadata-only observation of current inputs; does not establish artifact availability, installation success or runtime compatibility. Failure data may be null in the common envelope.",
  "type": "object",
  "required": [
    "preview_kind",
    "artifacts_prepared",
    "target",
    "declarations",
    "packages",
    "root_changes",
    "effects",
    "limitations"
  ],
  "properties": {
    "preview_kind": {
      "const": "resolved_graph"
    },
    "artifacts_prepared": {
      "const": false
    },
    "target": {
      "type": "string"
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section",
          "name",
          "before",
          "after"
        ],
        "properties": {
          "section": {
            "enum": [
              "dependencies",
              "devDependencies",
              "optionalDependencies",
              "peerDependencies"
            ]
          },
          "name": {
            "type": "string"
          },
          "before": {
            "type": [
              "string",
              "null"
            ]
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "source",
          "name",
          "version",
          "integrity",
          "dependencies",
          "change",
          "before",
          "after",
          "reasons"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "integrity": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "change": {
            "enum": [
              "added",
              "removed",
              "changed",
              "unchanged"
            ]
          },
          "before": {
            "anyOf": [
              {
                "$ref": "#/$defs/package"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "$ref": "#/$defs/package"
              },
              {
                "type": "null"
              }
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "graph",
                "relation",
                "parent",
                "dependency",
                "requirement"
              ],
              "properties": {
                "graph": {
                  "enum": [
                    "before",
                    "after"
                  ]
                },
                "relation": {
                  "enum": [
                    "direct",
                    "dependency"
                  ]
                },
                "parent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dependency": {
                  "type": "string"
                },
                "requirement": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "root_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "before",
          "after"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "before": {
            "type": [
              "string",
              "null"
            ]
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "required": [
        "network_allowed",
        "metadata_source",
        "metadata_lookups",
        "artifact_requests",
        "cache_reads",
        "cache_writes",
        "project_writes",
        "recovery",
        "scripts"
      ],
      "properties": {
        "network_allowed": {
          "type": "boolean"
        },
        "metadata_source": {
          "enum": [
            "lockfile",
            "fixture",
            "registry"
          ]
        },
        "metadata_lookups": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_requests": {
          "const": 0
        },
        "cache_reads": {
          "const": false
        },
        "cache_writes": {
          "const": false
        },
        "project_writes": {
          "const": false
        },
        "recovery": {
          "const": false
        },
        "scripts": {
          "const": false
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "starting_state": {
      "type": "object",
      "required": [
        "schema_version",
        "root_manifest",
        "selected_manifest",
        "workspace",
        "lock",
        "registry",
        "lifecycle_policy",
        "operation",
        "target",
        "consistency",
        "exclusions"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "root_manifest": {
          "$ref": "#/$defs/source_identity"
        },
        "selected_manifest": {
          "$ref": "#/$defs/source_identity"
        },
        "workspace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_identity"
          }
        },
        "lock": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "const": "absent"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "state",
                "digest"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256-[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "registry": {
          "type": "object",
          "required": [
            "identity_kind",
            "routing"
          ],
          "properties": {
            "identity_kind": {
              "const": "semantic_configuration"
            },
            "routing": {
              "type": "object",
              "required": [
                "origins",
                "routes",
                "default_origin",
                "jsr_origin",
                "credential_environment_names"
              ],
              "properties": {
                "origins": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "routes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "scope",
                      "origin",
                      "credential_environment_name"
                    ],
                    "properties": {
                      "scope": {
                        "type": "string"
                      },
                      "origin": {
                        "type": "string"
                      },
                      "credential_environment_name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "default_origin": {
                  "type": "string"
                },
                "jsr_origin": {
                  "type": "string"
                },
                "credential_environment_names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "lifecycle_policy": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "const": "absent_default_deny"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "state",
                "identity_kind",
                "digest"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "identity_kind": {
                  "const": "exact_source"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256-[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "operation": {
          "type": "object",
          "required": [
            "mode",
            "update",
            "allow_unverified_registry_artifacts"
          ],
          "properties": {
            "mode": {
              "enum": [
                "online",
                "refresh",
                "offline",
                "frozen",
                "ci",
                "ci_offline",
                "update"
              ]
            },
            "update": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "named",
                    "selection",
                    "save_policy"
                  ],
                  "properties": {
                    "named": {
                      "type": "boolean"
                    },
                    "selection": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "save_policy": {
                      "enum": [
                        "exact",
                        "caret",
                        "tilde",
                        null
                      ]
                    }
                  }
                }
              ]
            },
            "allow_unverified_registry_artifacts": {
              "type": "boolean"
            }
          }
        },
        "target": {
          "type": "string"
        },
        "consistency": {
          "const": "rechecked_non_atomic_observation"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Optional additive v1 evidence from rechecked inputs, not an atomic snapshot, saved execution plan or runtime assurance."
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "required": [
        "key",
        "source",
        "name",
        "version",
        "integrity",
        "dependencies"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "integrity": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "source_identity": {
      "type": "object",
      "required": [
        "identity_kind",
        "path",
        "digest"
      ],
      "properties": {
        "identity_kind": {
          "const": "exact_source"
        },
        "path": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256-[0-9a-f]{64}$"
        }
      }
    }
  }
}
