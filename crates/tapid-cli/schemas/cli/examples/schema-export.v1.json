{
  "id": "tapid.schema-export.v1",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:tapid:schema-export:v1",
    "title": "Tapid schema export payload v1",
    "type": "object",
    "required": [
      "id",
      "schema"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^tapid\\.[a-z][a-z-]*\\.v[1-9][0-9]*$"
      },
      "schema": {
        "type": "object",
        "required": [
          "$schema",
          "$id",
          "type"
        ],
        "properties": {
          "$schema": {
            "const": "https://json-schema.org/draft/2020-12/schema"
          },
          "$id": {
            "type": "string",
            "pattern": "^urn:tapid:"
          },
          "type": {
            "const": "object"
          }
        }
      }
    }
  }
}
